{
  "expo": {
    "name": "UniFyle",
    "slug": "UniFyle_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/unifyle-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDF4FF",
        "foregroundImage": "./assets/unifyle-adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/unifyle-favicon.png"
    },
    "scheme": "unifyle",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "UniFyle uses your photos to set your profile picture.",
          "cameraPermission": "UniFyle uses the camera to take your profile picture."
        }
      ]
    ]
  }
}
